else
  export NODE_PATH="/home/emanueleiva05/Proyectos/spotter_app/backend_spotter/node_modules/.pnpm/@angular-devkit+schematics-cli@22.1.5_@types+node@24.13.4_chokidar@5.0.0/node_modules/@angular-devkit/schematics-cli/node_modules:/home/emanueleiva05/Proyectos/spotter_app/backend_spotter/node_modules/.pnpm/@angular-devkit+schematics-cli@22.1.5_@types+node@24.13.4_chokidar@5.0.0/node_modules:/home/emanueleiva05/Proyectos/spotter_app/backend_spotter/node_modules/.pnpm/node_modules:$NODE_PATH"
